{
  "manifest_version": 3,
  "name": "multisport420",
  "version": "0.2.1",
  "description": "Companion for multisport420.web.app that manages video playback, mute controls, and intrusive popups.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pooembed.eu/embed-noads/*"
      ],
      "js": [
        "pooembed.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://embedsports.top/embed/*"
      ],
      "js": [
        "embedsports.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
