{
  "manifest_version": 3,
  "name": "multisport420",
  "version": "0.3.0",
  "description": "Companion for multisport420.web.app: video playback, mute controls, popup blocking, and live ESPN fantasy scoreboards.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pooembed.eu/embed-noads/*"
      ],
      "js": [
        "pooembed.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://embedsports.top/embed/*"
      ],
      "js": [
        "embedsports.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://multisport420.web.app/*",
        "*://localhost/*"
      ],
      "js": [
        "content_script.js"
      ]
    },
    {
      "matches": [
        "https://fantasy.espn.com/football/*"
      ],
      "js": [
        "scoreboard_content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://multisport420.web.app/*",
      "*://localhost/*"
    ]
  },
  "host_permissions": [
    "https://fantasy.espn.com/*",
    "https://lm-api-reads.fantasy.espn.com/*"
  ]
}
