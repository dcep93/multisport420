# Firebase Hosting automatically supplies /__/firebase/init.json in production.
# For local Vite development, copy to .env.local and use the EXISTING project's
# Web App config from Firebase Console > Project settings > Your apps.
VITE_FIREBASE_CONFIG={"apiKey":"your-web-api-key","projectId":"your-existing-project","databaseURL":"https://your-existing-database.firebaseio.com","appId":"your-web-app-id"}

# Optional, local development only:
# VITE_FIREBASE_DATABASE_EMULATOR=127.0.0.1:9000
